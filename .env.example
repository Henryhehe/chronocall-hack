# Set this for real Gemini calls. Never commit .env.local or real API keys.
GEMINI_API_KEY=""

# Optional. Demo mode uses local fixtures; live voice and Genie are disabled.
DEMO_MODE=false

# One server serves the UI, HTTP API, and WebSocket bridge.
PORT=3000
HOST=0.0.0.0

# Optional public HTTPS origin for Museum AR phone QR links (no /museum suffix).
# Leave empty locally to infer the current origin.
APP_URL=
